**/node_modules
.next
**/.next
out
dist
.git
.gitignore
.env
.env.*
!.env.example
*.tsbuildinfo
.nx
coverage
Dockerfile
.dockerignore
docker-compose.yml
README.md
HOWTOHOST.md
docs
.vscode
.idea
.DS_Store
