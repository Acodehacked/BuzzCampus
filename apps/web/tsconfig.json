{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@buzz/db": ["../../packages/db/src/index.ts"],
      "@buzz/db/*": ["../../packages/db/src/*"],
      "@buzz/core": ["../../packages/core/src/index.ts"],
      "@buzz/core/*": ["../../packages/core/src/*"],
      "@buzz/ui": ["../../packages/ui/src/index.ts"],
      "@buzz/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
