# ── Database ──────────────────────────────────────────────────────────
# Any Postgres works. Neon is what the PRD targets; a local instance is
# fine for development. postgres-js connects over TCP either way — the
# client turns TLS on automatically for anything that isn't localhost.
#
#   Neon:   postgresql://user:pass@ep-xxx.region.aws.neon.tech/buzz?sslmode=require
#   Local:  postgresql://postgres:postgres@localhost:5432/buzz
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buzz

# Optional. When set, the transactional tests in packages/core run against
# this database. Without it they skip and only the pure unit tests run.
# Point it at a THROWAWAY database — the tests write real rows.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buzz_test

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-real-secret

# ── Campus email restriction ──────────────────────────────────────────
# Comma-separated allowlist. Subdomains are included automatically, which
# is what you want for department-scoped addresses:
#
#   CAMPUS_EMAIL_DOMAINS=sjcetpalai.ac.in
#     ✔ abinantony2028@sjcetpalai.ac.in
#     ✔ abinantony2028@es.sjcetpalai.ac.in
#     ✘ someone@othercollege.ac.in
#
# THIS IS THE SETTING TO USE IN PRODUCTION. Buzz serves one campus, and
# an allowlist is the only rule that actually restricts sign-up to it.
CAMPUS_EMAIL_DOMAINS=buzzcampus.edu

# Only consulted when CAMPUS_EMAIL_DOMAINS is empty.
#
#   academic  — accept only domains carrying an academic marker (.edu,
#               .ac.*, uni-*, univ-*, student.*, …). Good for a
#               multi-college consortium. Note it rejects universities
#               with no marker in the name: ethz.ch, tudelft.nl, mcgill.ca.
#
#   (unset)   — accept anything that isn't a known consumer or disposable
#               provider. This is the default, and it's what lets a fresh
#               clone work for ANY college on earth. It also accepts
#               company and personal domains, so don't ship with it.
# CAMPUS_EMAIL_MODE=academic

# ── App ───────────────────────────────────────────────────────────────
# Only needed if the app isn't served from localhost:3000.
# NEXT_PUBLIC_APP_URL=https://buzz.example.edu

# The domain the seed script hands out to its demo accounts. Must be
# allowed by CAMPUS_EMAIL_DOMAINS above, or you won't be able to sign in
# as them.
SEED_EMAIL_DOMAIN=buzzcampus.edu
